        {
          "name": "4. Get Pet after update (GET /pet/{petId})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const petSchema = JSON.parse(pm.collectionVariables.get('petSchema'));",
                  "",
                  "pm.test('Status code is 200 (documented: successful operation)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response body matches the Pet schema', function () {",
                  "    pm.response.to.have.jsonSchema(petSchema);",
                  "});",
                  "",
                  "pm.test('Persisted pet shows the updated name and status', function () {",
                  "    const pet = pm.response.json();",
                  "    pm.expect(String(pet.id)).to.eql(pm.collectionVariables.get('petId'));",
                  "    pm.expect(pet.name).to.eql(pm.collectionVariables.get('petNameUpdated'));",
                  "    pm.expect(pet.status).to.eql('sold');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet/{{petId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet",
