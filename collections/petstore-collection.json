              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The spec documents no response body for 200 'Pet deleted', so only the status code is asserted.",
                  "pm.test('Status code is 200 (documented: Pet deleted)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
