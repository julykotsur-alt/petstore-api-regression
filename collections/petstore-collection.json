              ]
            }
          },
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "response": []
        },
        {
          "name": "6. Verify deletion (GET /pet/{petId})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// GET /pet/{petId} documents 404 'Pet not found'. No response body schema is documented for 404, so only the status is asserted.",
                  "pm.test('Status code is 404 (documented: Pet not found)', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
